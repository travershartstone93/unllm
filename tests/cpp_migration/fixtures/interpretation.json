        {
          "id": "source_input",
          "kind": "number_input",
          "state": "input_value",
          "label": "Celsius"
        },
        {
          "id": "converted_output",
          "kind": "label",
          "value": "output_value",
          "label": "Fahrenheit"
        }
      ],
      "actions": [
        {
          "id": "convert",
          "label": "Convert",
          "ensure": "5 * next.output_value == 9 * prev.input_value + (160)"
