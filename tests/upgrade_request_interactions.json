        "value": false
      },
      {
        "kind": "append",
        "target": "body_view",
        "text": "!"
      },
      {
        "kind": "expect_text",
        "target": "chars_view",
        "value": "Characters: 18"
      },
      {
        "kind": "click",
        "target": "save"
      },
      {
        "kind": "expect_file",
        "path": "/output/note.txt",
        "value": "mixed case\ncafé 🐦!"
      },
      {
        "kind": "expect_save_calls",
        "value": 1
      },
      {
        "kind": "append",
        "target": "body_view",
        "text": "?"
