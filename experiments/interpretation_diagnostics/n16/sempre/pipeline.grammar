(rule $N ($PHRASE) (ConstantFn (string numbers)))
(rule $T ($PHRASE) (ConstantFn (string lines)))
(rule $TStep ($PHRASE) (ConstantFn (string strip)))
(rule $TStep ($PHRASE) (ConstantFn (string lower)))
(rule $Step ($PHRASE) (ConstantFn (string reverse)))
(rule $Step ($PHRASE) (ConstantFn (string unique)))
(rule $NStep ($PHRASE) (ConstantFn (string double)))
(rule $NStep ($PHRASE) (ConstantFn (string negative)))
(rule $Out ($PHRASE) (ConstantFn (string count)))
(rule $NOut ($PHRASE) (ConstantFn (string sum)))
(rule $Out ($PHRASE) (ConstantFn (string values)))
(rule $Stop ($PHRASE) (ConstantFn (string reject)))
(rule $ROOT ($Stop) (IdentityFn))
(rule $NStep ($Step) (IdentityFn))
(rule $TStep ($Step) (IdentityFn))
(rule $Step ($Stop) (IdentityFn))
(rule $Out ($Stop) (IdentityFn))
(rule $NOut ($Out) (IdentityFn))
(rule $N ($N $NStep) (ConcatFn " "))
(rule $T ($T $TStep) (ConcatFn " "))
(rule $ROOT ($N $NOut) (ConcatFn " "))
(rule $ROOT ($T $Out) (ConcatFn " "))
